/* =========================
   CABEÇALHO
========================= */

.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 24px;
}

.breadcrumb {
    display: block;

    margin-bottom: 5px;

    color: #8796a1;

    font-size: 12px;
}

.page-header h1 {
    margin: 0;

    color: #1d3546;

    font-size: 27px;
    font-weight: 750;
}

.page-header-actions {
    display: flex;
    align-items: center;

    gap: 12px;
}


/* =========================
   BUSCA
========================= */

.search-form {
    margin: 0;
}

.search-input {
    width: 280px;
    height: 40px;

    display: flex;
    align-items: center;

    gap: 9px;

    padding: 0 12px;

    background: #ffffff;

    border: 1px solid #dce6eb;
    border-radius: 7px;

    box-sizing: border-box;
}

.search-input i {
    color: #8a9aa5;

    font-size: 13px;
}

.search-input input {
    width: 100%;

    border: 0;
    outline: 0;

    background: transparent;

    color: #344b5a;

    font-size: 12px;
}

.search-input input::placeholder {
    color: #9aa8b1;
}


/* =========================
   BOTÃO PRINCIPAL
========================= */

.btn-primary {
    height: 40px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 0 17px;

    background: #147fc0;

    border-radius: 7px;

    color: #ffffff;

    text-decoration: none;

    font-size: 12px;
    font-weight: 700;

    box-sizing: border-box;

    transition: 0.18s ease;
}

.btn-primary:hover {
    background: #106fa9;
}


/* =========================
   CARDS
========================= */

.stats-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 14px;

    margin-bottom: 20px;
}

.stat-card {
    min-height: 86px;

    display: flex;
    align-items: center;

    gap: 13px;

    padding: 16px;

    background: #ffffff;

    border: 1px solid #e4ebef;

    border-radius: 8px;

    box-sizing: border-box;
}

.stat-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #edf8fa;

    border-radius: 8px;

    color: #1598b2;

    font-size: 15px;
}

.stat-card span {
    display: block;

    margin-bottom: 4px;

    color: #84939d;

    font-size: 11px;
}

.stat-card strong {
    display: block;

    color: #263d4d;

    font-size: 19px;
}


/* =========================
   CARD PRINCIPAL
========================= */

.content-card {
    background: #ffffff;

    border: 1px solid #e4ebef;

    border-radius: 9px;

    overflow: hidden;
}


/* =========================
   ABAS
========================= */

.tabs {
    height: 50px;

    display: flex;
    align-items: flex-end;

    gap: 24px;

    padding: 0 20px;

    border-bottom: 1px solid #e8eef1;

    box-sizing: border-box;
}

.tab {
    position: relative;

    height: 50px;

    padding: 0;

    border: 0;

    background: transparent;

    color: #7d8c96;

    font-size: 12px;
    font-weight: 600;

    cursor: pointer;
}

.tab.active {
    color: #168bab;
}

.tab.active::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: -1px;

    height: 2px;

    background: #1598b2;
}


/* =========================
   FILTROS
========================= */

.filter-area {
    padding: 16px 20px;

    border-bottom: 1px solid #edf1f3;
}

.filter-form {
    display: flex;
    align-items: flex-end;

    gap: 12px;
}

.filter-field {
    display: flex;
    flex-direction: column;

    gap: 5px;
}

.filter-field label {
    color: #72828d;

    font-size: 10px;
    font-weight: 600;
}

.filter-field input {
    height: 34px;

    min-width: 160px;

    padding: 0 9px;

    border: 1px solid #dce5e9;
    border-radius: 6px;

    outline: none;

    color: #435766;

    font-size: 11px;

    box-sizing: border-box;
}

.filter-field input:focus {
    border-color: #57b8c8;
}

.filter-buttons {
    display: flex;

    gap: 7px;
}

.btn-filter {
    height: 34px;

    padding: 0 13px;

    border: 0;
    border-radius: 6px;

    background: #1598b2;

    color: #ffffff;

    font-size: 11px;
    font-weight: 700;

    cursor: pointer;
}

.btn-reset {
    height: 34px;

    display: flex;
    align-items: center;

    padding: 0 12px;

    border: 1px solid #dce5e9;
    border-radius: 6px;

    color: #71818c;

    text-decoration: none;

    font-size: 11px;

    box-sizing: border-box;
}

.filter-info {
    margin-top: 10px;

    color: #657985;

    font-size: 11px;
}


/* =========================
   TABELA
========================= */

.table-wrapper {
    width: 100%;

    overflow-x: auto;
}

.patients-table {
    width: 100%;

    border-collapse: collapse;

    font-size: 11px;
}

.patients-table th {
    height: 40px;

    padding: 0 20px;

    background: #fbfcfd;

    border-bottom: 1px solid #e8eef1;

    color: #71828d;

    text-align: left;

    font-size: 10px;
    font-weight: 700;

    white-space: nowrap;
}

.patients-table td {
    height: 62px;

    padding: 8px 20px;

    border-bottom: 1px solid #edf1f3;

    color: #526570;

    white-space: nowrap;
}

.patients-table tbody tr:hover {
    background: #fbfdfe;
}


/* =========================
   PACIENTE
========================= */

.patient-name {
    display: flex;
    align-items: center;

    gap: 10px;
}

.patient-avatar {
    width: 31px;
    height: 31px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    background: #e9f5f7;

    border-radius: 50%;

    color: #168da5;

    font-size: 11px;
    font-weight: 700;
}

.patient-name strong {
    display: block;

    margin-bottom: 3px;

    color: #344c5b;

    font-size: 11px;
}

.patient-name span {
    display: block;

    color: #91a0a9;

    font-size: 9px;
}


/* =========================
   AÇÕES
========================= */

.table-actions {
    display: flex;

    align-items: center;

    gap: 5px;
}

.action-button {
    width: 29px;
    height: 29px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #e0e8ec;
    border-radius: 6px;

    background: #ffffff;

    color: #6e8490;

    text-decoration: none;

    cursor: pointer;

    font-size: 10px;
}

.action-button:hover {
    background: #eef8fa;

    border-color: #cce8ed;

    color: #168da5;
}

.action-button.danger:hover {
    background: #fff2f2;

    border-color: #f1d3d3;

    color: #d45454;
}


/* =========================
   ESTADOS
========================= */

.not-available {
    color: #aab5bb;
}

.empty-table {
    height: 250px !important;

    text-align: center !important;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 7px;

    color: #8b9aa3;
}

.empty-state i {
    margin-bottom: 4px;

    color: #b3c4cc;

    font-size: 25px;
}

.empty-state strong {
    color: #60737e;

    font-size: 12px;
}

.empty-state span {
    font-size: 10px;
}


/* =========================
   RODAPÉ
========================= */

.table-footer {
    min-height: 50px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 20px;

    color: #82919a;

    font-size: 10px;
}

.btn-exportar {
    display: inline-flex;
    align-items: center;

    gap: 6px;

    color: #168da5;

    text-decoration: none;

    font-size: 10px;
    font-weight: 600;
}


/* =========================
   RESPONSIVO
========================= */

@media (max-width: 1000px) {

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .page-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .page-header-actions {
        width: 100%;
    }

    .search-input {
        width: 100%;
    }

    .search-form {
        flex: 1;
    }
}


@media (max-width: 700px) {

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .filter-form {
        align-items: stretch;
        flex-direction: column;
    }

    .filter-field input {
        width: 100%;
    }

    .filter-buttons {
        margin-top: 4px;
    }

}